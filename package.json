{
  "name": "skt-manpyeong-store-checklist",
  "version": "0.1.0",
  "private": true,
  "description": "SK텔레콤 대구만평대리점 매장 점검 체크리스트 웹앱 (Google Apps Script + Sheets)",
  "scripts": {
    "login": "clasp login",
    "create": "clasp create --type webapp --title \"만평대리점_체크리스트\" --rootDir ./src",
    "push": "clasp push",
    "pull": "clasp pull",
    "open": "clasp open",
    "deploy": "clasp deploy --description \"release\"",
    "logs": "clasp logs --watch"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2"
  }
}
